# ==============================================================================
# AutoPilot AI Trading Platform - Environment Configuration Template
# ==============================================================================

# Application Settings
APP_NAME="AutoPilot AI Trading Platform"
APP_ENV="development"                  # "development" | "production" | "test"
DEBUG=false
PORT=8000
HOST="0.0.0.0"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Security & Authentication
# In production, generate a secure 256-bit random key: openssl rand -hex 32
JWT_SECRET_KEY="autopilot-super-secret-jwt-key-minimum-32-chars-long"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440   # 24 hours

# Database Persistence (PostgreSQL / Supabase compatible, defaults to local SQLite)
DATABASE_URL="sqlite:///./backend/data/autopilot.db"
# Example PostgreSQL / Supabase connection:
# DATABASE_URL="postgresql+asyncpg://postgres:yourpassword@db.yourproject.supabase.co:5432/postgres"

# Strict Paper Trading Safety Assertion
INITIAL_VIRTUAL_CAPITAL_INR=500.00     # Exactly INR 500.00 starting capital
STRICT_PAPER_TRADING_ONLY=true         # CRITICAL: Always true. Live order routing is hard-locked.

# Market Data Provider
# Supported: "live_nse" (Default zero-login live NSE feed) | "angel_one" (SmartAPI) | "demo"
MARKET_DATA_PROVIDER="live_nse"
MARKET_DATA_IS_DEMO=false              # False enables "REAL FEED (PAPER EXECUTION)" banner in UI
MARKET_HOURS_GATE_ENABLED=true         # Enforce 09:15 to 15:30 IST Mon-Fri market session gate
STALE_DATA_THRESHOLD_SECONDS=60        # Quotes older than 60s are flagged

# Angel One SmartAPI Credentials (Optional - primary real-time broker feed. If empty, falls back to live_nse)
ANGEL_ONE_API_KEY=""
ANGEL_ONE_CLIENT_CODE=""
ANGEL_ONE_MPIN=""
ANGEL_ONE_TOTP_TOKEN=""                # Base32 TOTP Secret Key for pyotp 2FA generation

# Legacy / Upstox API Credentials (Optional)
UPSTOX_API_KEY=""
UPSTOX_API_SECRET=""

# Risk Management Guardrails
MAX_POSITION_SIZE_PCT=100.0            # 100% permitted for micro ₹500 account whole-share purchase
MAX_DAILY_LOSS_PCT=2.0                 # Halt if daily net loss exceeds 2% of starting capital (₹10.00 trigger)
MAX_DAILY_LOSS_INR=10.00               # Absolute daily loss trigger in INR
MAX_PORTFOLIO_DRAWDOWN_PCT=15.0        # Halt if portfolio drawdown exceeds 15% (₹75.00 on ₹500)
EMERGENCY_STOP_ACTIVE=false            # Kill switch default state

# Quantitative Strategy & Cost-Aware Gate
COST_AWARE_GATE_MULTIPLIER=3.0         # Expected move must be >= 3.0 * total round-trip friction
SIMULATED_SLIPPAGE_BPS=7.5             # 7.5 bps (0.075%) realistic order book slippage
SIMULATED_SPREAD_BPS=10.0              # 10 bps (0.10%) realistic bid-ask spread

# Background Auto-Pilot Runner
AUTOPILOT_RUNNER_ENABLED=true
AUTOPILOT_INTERVAL_SECONDS=10.0         # Seconds between market scan and evaluation cycles
